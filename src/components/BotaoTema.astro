---
// BotaoTema.astro — alterna entre tema claro e escuro.
// Começa escondido (hidden): sem JavaScript ele não funcionaria,
// então só aparece quando o script abaixo roda. Sem JS, o site
// simplesmente segue o tema do sistema.
---

<button type="button" class="botao-tema" data-botao-tema hidden aria-label="Mudar o tema">
  <!-- Sol: aparece no tema escuro (clicar leva ao claro) -->
  <svg class="icone icone-sol" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- Lua: aparece no tema claro (clicar leva ao escuro) -->
  <svg class="icone icone-lua" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
  </svg>
</button>

<script>
  // Este script é empacotado pelo Astro e pode importar arquivos .ts.
  import { temaAtual, salvarTema } from '../lib/preferencias';

  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-botao-tema]');

  function atualizar() {
    const tema = temaAtual();
    botoes.forEach((botao) => {
      botao.dataset.mostra = tema;
      botao.setAttribute(
        'aria-label',
        tema === 'escuro' ? 'Mudar para o tema claro' : 'Mudar para o tema escuro',
      );
    });
  }

  botoes.forEach((botao) => {
    botao.hidden = false;
    botao.addEventListener('click', () => {
      salvarTema(temaAtual() === 'escuro' ? 'claro' : 'escuro');
      atualizar();
    });
  });

  // Se o aluno nunca escolheu e o sistema mudar, o ícone acompanha.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', atualizar);
  atualizar();
</script>

<style>
  .botao-tema {
    display: inline-grid;
    place-items: center;
    width: var(--altura-toque);
    height: var(--altura-toque);
    border: var(--borda-fina) solid var(--borda);
    border-radius: var(--raio-pilula);
    background: var(--superficie);
    color: var(--texto);
    cursor: pointer;
  }
  .botao-tema[hidden] {
    display: none;
  }
  .icone {
    width: var(--espaco-4);
    height: var(--espaco-4);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  [data-mostra='escuro'] .icone-lua,
  [data-mostra='claro'] .icone-sol {
    display: none;
  }
</style>

---
// DiagramaCampoCristalino.astro — prévia ESTÁTICA do hero da página inicial.
// Mostra só a ideia qualitativa: no campo octaédrico, os 5 orbitais d
// se separam em 3 de menor energia (t2g) e 2 de maior energia (eg),
// separados por Δo. Não há nenhum valor numérico aqui.
// Na Fase 2+ entra a simulação interativa; esta imagem continua como
// versão sem JavaScript (critério de aceite 4 do prompt da interface).
interface Props {
  descricao: string;
}
const { descricao } = Astro.props;
---

<figure class="diagrama">
  <svg viewBox="0 0 320 220" role="img" aria-label={descricao}>
    <!-- Eixo de energia -->
    <line class="eixo" x1="28" y1="200" x2="28" y2="20" />
    <path class="eixo" d="M22 30 28 20 34 30" />
    <text class="rotulo" x="20" y="120" transform="rotate(-90 20 120)" text-anchor="middle">Energia</text>

    <!-- Íon livre: 5 orbitais d com a mesma energia -->
    {[0, 1, 2, 3, 4].map((i) => <line class="nivel" x1={56 + i * 16} y1="120" x2={68 + i * 16} y2="120" />)}
    <text class="legenda-svg" x="92" y="146" text-anchor="middle">íon livre</text>

    <!-- Ligações tracejadas até os níveis separados -->
    <path class="guia" d="M136 120 L196 70 M136 120 L196 160" />

    <!-- eg (2 orbitais, acima) -->
    {[0, 1].map((i) => <line class="nivel" x1={204 + i * 20} y1="70" x2={220 + i * 20} y2="70" />)}
    <text class="simbolo-orbital" x="262" y="75">e<tspan class="indice" dy="4">g</tspan></text>

    <!-- t2g (3 orbitais, abaixo) -->
    {[0, 1, 2].map((i) => <line class="nivel" x1={196 + i * 20} y1="160" x2={212 + i * 20} y2="160" />)}
    <text class="simbolo-orbital" x="262" y="165">t<tspan class="indice" dy="4">2g</tspan></text>

    <!-- Δo -->
    <line class="delta" x1="300" y1="74" x2="300" y2="156" />
    <path class="delta" d="M295 82 300 72 305 82 M295 148 300 158 305 148" />
    <text class="simbolo-orbital" x="306" y="120" text-anchor="end" dx="-12">Δ<tspan class="indice" dy="4">o</tspan></text>
  </svg>
  <figcaption class="legenda">
    Campo octaédrico, modelo qualitativo. A simulação interativa chega com os módulos de coordenação.
  </figcaption>
</figure>

<style>
  .diagrama {
    margin: 0;
    display: grid;
    gap: var(--espaco-3);
  }
  svg {
    width: 100%;
    height: auto;
  }
  .eixo,
  .delta {
    stroke: var(--texto-secundario);
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nivel {
    stroke: var(--destaque);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .guia {
    stroke: var(--borda);
    stroke-width: 2;
    stroke-dasharray: 4 4;
    fill: none;
  }
  text {
    fill: var(--texto);
    font-family: var(--fonte-mono);
  }
  .rotulo,
  .legenda-svg {
    fill: var(--texto-secundario);
    font-family: var(--fonte-texto);
    font-size: var(--tamanho-rotulo);
  }
  .simbolo-orbital {
    font-size: var(--tamanho-h3);
  }
  .indice {
    font-size: var(--tamanho-legenda);
  }
</style>
